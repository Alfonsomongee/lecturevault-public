{
  "name": "lecturevault",
  "version": "0.1.0",
  "description": "Local-first academic recording assistant — capture, transcribe, and study from your Collab2 classes",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "npm run clean && tsc",
    "start": "node dist/index.js serve",
    "dev": "tsx src/index.ts",
    "sync": "tsx src/index.ts sync",
    "accept:manual": "tsx src/index.ts accept-manual",
    "inspect:player": "tsx src/index.ts inspect-player",
    "check:hardware": "tsx src/utils/hardware.ts",
    "capture:audio": "tsx src/index.ts capture-audio",
    "capture:and:transcribe": "tsx src/index.ts capture-and-transcribe",
    "batch:transcribe": "tsx src/index.ts batch-transcribe",
    "auto:daily": "tsx src/index.ts auto-daily",
    "auto:daily:dry": "tsx src/index.ts auto-daily --dry-run",
    "schedule:daily": "powershell -ExecutionPolicy Bypass -File scripts/register-scheduled-task.ps1",
    "transcribe:test": "tsx src/transcriber/transcribe-cli.ts",
    "refine:transcript": "tsx src/ai/refine-cli.ts",
    "ingest": "tsx src/index.ts ingest",
    "courses": "tsx src/index.ts courses",
    "study": "tsx src/index.ts study",
    "notes:eval": "tsx src/index.ts notes-eval",
    "ai:check": "tsx src/index.ts ai-check",
    "search": "tsx src/index.ts search",
    "ask": "tsx src/index.ts ask",
    "export": "tsx src/index.ts export",
    "export:web": "tsx src/cli/export-web.ts",
    "optimize:audio": "tsx src/index.ts optimize-audio",
    "demo": "tsx src/index.ts demo",
    "serve": "tsx src/index.ts serve",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:coverage": "vitest run --coverage",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "better-sqlite3": "12.9.0",
    "dompurify": "^3.4.16",
    "dotenv": "^16.4.7",
    "express": "^4.21.1",
    "katex": "^0.19.0",
    "marked": "^18.1.0",
    "pino": "^9.5.0",
    "pino-pretty": "^13.0.0",
    "playwright": "^1.49.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.1",
    "@types/better-sqlite3": "^7.6.12",
    "@types/express": "^4.17.25",
    "@types/node": "^22.10.0",
    "@vitest/coverage-v8": "^2.1.9",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "license": "MIT",
  "private": true
}
