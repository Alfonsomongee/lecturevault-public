# ──────────────────────────────────────────────
# LectureVault — Environment Configuration
# Copy this file to .env and adjust values.
# NEVER commit the .env file to version control.
# ──────────────────────────────────────────────

# ── University LMS ────────────────────────────
# Base URL of your university's LMS (e.g. Blackboard Learn)
LMS_BASE_URL=https://campusvirtual.tu-universidad.edu

# Path to the Collab2 recordings page (relative to LMS_BASE_URL)
COLLAB_RECORDINGS_PATH=/ultra/courses

# Strict allowlist of explicit hosts (comma-separated, NO wildcards).
# e.g., Blackboard host and third-party Collab2 host if on a separate domain:
ALLOWED_HOSTS=campusvirtual.tu-universidad.edu,collab2.bbcollab.com,eu.bbcollab.com

# Course or subject identifier used for stable compound keys
COURSE_IDENTIFIER=curso-ejemplo-2026

# Optional: Campus credentials for unattended daily sync (auto-daily)
LMS_USERNAME=
LMS_PASSWORD=

# ── Diagnostics ───────────────────────────────
# Enable sanitized DOM table snapshots in ./data/diagnostics/
ENABLE_DIAGNOSTICS=false

# Enable screenshots during diagnostics (NEVER captures auth pages)
SCREENSHOT_DIAGNOSTICS=false
DIAGNOSTICS_DIR=./data/diagnostics

# ── Browser ───────────────────────────────────
# Directory for Chromium persistent profile (relative to project root)
BROWSER_PROFILE_DIR=./data/browser-profile

# Run browser in headed mode (true) or headless (false)
BROWSER_HEADED=true

# Browser viewport width
BROWSER_VIEWPORT_WIDTH=1280

# Browser viewport height
BROWSER_VIEWPORT_HEIGHT=720

# Navigation timeout in milliseconds
BROWSER_TIMEOUT_MS=30000

# ── Database ──────────────────────────────────
# Path to SQLite database file. Leave commented to keep it in DATA_DIR (see "Local data" below).
# Relative paths in this file are relative to the project folder, never to where you run the command.
# If the project lives in OneDrive, Dropbox or Google Drive, put the database OUTSIDE it: sync tools can
# bring back an old copy of the file without warning (it happened on 2026-11-07). On Windows, for example:
# DATABASE_PATH=C:/Users/<tu-usuario>/AppData/Local/LectureVault/lecturevault.db
# DATABASE_PATH=./data/lecturevault.db

# ── Dashboard ─────────────────────────────────
# Dashboard server port (localhost only)
DASHBOARD_PORT=3000

# ── Logging ───────────────────────────────────
# Log level: trace, debug, info, warn, error, fatal
LOG_LEVEL=info

# Directory for log files and failure screenshots (default: logs/ inside DATA_DIR)
# LOG_DIR=./data/logs

# Directory for failure screenshots (default: screenshots/ inside DATA_DIR)
# SCREENSHOT_DIR=./data/screenshots

# ── Google Gemini AI Studio ───────────────────
# Optional: API key for AI-based transcript filtering, noise removal, and synthesis
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini model used for notes, alerts, flashcards and Q&A
GEMINI_MODEL=gemini-2.5-flash
# Text requests per minute to Gemini (free tier). Requests are spaced to stay under it, and a per-minute
# 429 waits what Gemini asks instead of jumping to the paid DeepSeek fallback. 0 = no pacing.
# GEMINI_RPM=8

# Embedding model used for semantic search ("ask your classes")
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# ── DeepSeek (fallback de IA) ─────────────────
# Optional: API key used as automatic fallback when Gemini fails (or as text/JSON provider)
# NOTES_FACTS=false  # false (por defecto) = una sola llamada por tanda de apuntes; true = dos pasadas (hechos verificados y redacción), el doble de llamadas
# DEEPSEEK_API_KEY=your_deepseek_api_key_here
# DEEPSEEK_MODEL=deepseek-v4-flash   # `deepseek-chat` se retiró el 24-07-2026; si sigue en tu .env se usa V4 Flash

# ── Local data ────────────────────────────────
# Root folder for audio/, transcripts/ and exports/ (and, unless set above, the database, logs and browser
# profile). Moving it moves all of them. Back this folder up.
# What you delete from a class goes to <DATA_DIR>/trash for 30 days before it is gone for good.
DATA_DIR=./data

# ── Database copies ───────────────────────────
# Where copies of the database go: one a day while the server runs, one right before every schema update,
# and the ones you make from Ajustes. Default: backups/ in the project folder (outside data/).
# Point it at another disk or a synced folder (OneDrive...) to survive a disk failure.
# BACKUP_DIR=D:/LectureVaultBackups

# ── University calendar ───────────────────────
# Optional: your campus .ics feed (VIU: oncampus.universidadviu.com › Calendario › exportar).
# It carries a personal token: keep it in .env only. Synced on start and every 6 hours.
LMS_CALENDAR_URL=

# ── Upload transcripts to git ─────────────────
# Commit and push each new transcript (with its notes) to your git remote once it is ready.
# Off by default: uploading is a publication. It only uploads from GIT_SYNC_BRANCH, only commits the
# transcript folder, never pushes your own unpushed commits, and refuses a GitHub repository that is
# public (set GIT_SYNC_ALLOW_PUBLIC=true only if you really want that).
AUTO_GIT_SYNC=false
GIT_SYNC_BRANCH=main
GIT_SYNC_ALLOW_PUBLIC=false
